import { Theme } from "../styles/theme.slint";
import { RGBSplitText } from "../effects/rgb-split-text.slint";

// 一行: Hub (checkbox + 粗体) 或 Editor (缩进 + 版本号)
export component GroupRow inherits Rectangle {
    in-out property <bool> selected;
    in property <string> version;
    in property <string> path;
    in property <string> status-label;
    in property <color> status-color;
    in property <bool> working;
    in property <bool> disabled;
    in property <bool> is-group-header;
    callback toggled;

    height: 44px;
    horizontal-stretch: 1;
    background: (!root.disabled && area.has-hover) ? Theme.purple-bg-2 : transparent;
    opacity: root.disabled ? 0.35 : 1;
    property <length> indent: root.is-group-header ? 0px : 18px;
    property <length> tree-x: 22px;

    // 底部 1px 暗紫分隔线
    Rectangle {
        x: 0; y: parent.height - 1px;
        width: 100%; height: 1px;
        background: #2a1a4a;
    }

    area := TouchArea {
        width: 100%; height: 100%;
        mouse-cursor: root.disabled ? default : pointer;
        clicked => { if !root.working && !root.disabled { root.toggled(); } }
    }

    // 左 4px 状态色条
    Rectangle {
        x: 0; y: 0;
        width: 4px; height: 100%;
        background: root.status-color;
        drop-shadow-color: root.status-color;
        drop-shadow-blur: (!root.disabled && area.has-hover) ? 10px : 4px;
        drop-shadow-offset-x: 0;
        drop-shadow-offset-y: 0;
    }

    // 树形连接线 (子行)
    if !root.is-group-header : Rectangle {
        x: root.tree-x; y: 0;
        width: 1px; height: 100%;
        background: Theme.purple-line;
        opacity: 0.5;
    }
    if !root.is-group-header : Rectangle {
        x: root.tree-x;
        y: (parent.height - Theme.checkbox-size) / 2 + Theme.checkbox-size / 2 - 0.5px;
        width: 14px; height: 1px;
        background: Theme.purple-line;
        opacity: 0.5;
    }

    content := Rectangle {
        width: 100%; height: 100%;

        // checkbox (仅 Hub 行显示)
        if root.is-group-header : Rectangle {
            x: 14px; y: (parent.height - Theme.checkbox-size) / 2;
            width: Theme.checkbox-size; height: Theme.checkbox-size;
            border-radius: 1px;
            border-width: 1px;
            border-color: root.selected
                ? Theme.magenta-50
                : (!root.disabled && area.has-hover) ? Theme.cyan-50 : Theme.purple-line;
            background: root.selected ? Theme.magenta-50 : transparent;
            drop-shadow-color: root.selected
                ? Theme.magenta-glow
                : (!root.disabled && area.has-hover) ? Theme.cyan-glow-soft : transparent;
            drop-shadow-blur: 6px;
            drop-shadow-offset-x: 0;
            drop-shadow-offset-y: 0;

            if root.selected : Rectangle {
                x: (parent.width - 6px) / 2;
                y: (parent.height - 6px) / 2;
                width: 6px; height: 6px;
                background: Theme.purple-bg-0;
            }
        }

        // RGB 色彩分离层
        RGBSplitText {
            x: 40px + root.indent;
            y: 4px;
            width: parent.width - 160px - root.indent;
            height: 20px;
            clip: true;
            text: root.version;
            font-family: Theme.font-mono;
            font-size: Theme.font-lg;
            font-weight: root.is-group-header ? 800 : 600;
            text-color: transparent;
            offset: 1px;
            active: !root.disabled && area.has-hover;
        }

        // 主文字
        version-text := Text {
            x: 40px + root.indent;
            y: 4px;
            width: parent.width - 160px - root.indent;
            height: 20px;
            text: root.version;
            font-family: Theme.font-mono;
            font-size: Theme.font-lg;
            font-weight: root.is-group-header ? 800 : 600;
            color: (!root.disabled && area.has-hover) ? Theme.cyan-bright : Theme.cyan-50;
            vertical-alignment: center;
        }

        // 子行: Hub = 路径, Editor = 路径
        Text {
            x: 40px + root.indent;
            y: 23px;
            width: parent.width - 160px - root.indent;
            height: 18px;
            text: root.path;
            font-family: Theme.font-mono;
            font-size: Theme.font-xs;
            color: Theme.text-faint;
            overflow: elide;
            vertical-alignment: center;
        }
    }

    // 状态徽章
    Rectangle {
        in property <bool> pulse-active: root.selected || (!root.disabled && area.has-hover);
        in-out property <float> phase: 0;
        in property <float> pulse: pulse-active ? (sin(phase * 360deg) + 1) / 2 : 0.5;

        Timer {
            interval: 33ms;
            running: true;
            triggered => {
                phase = mod(phase + 0.0165, 1);
            }
        }

        x: parent.width - self.width - 12px;
        y: (parent.height - self.height) / 2;
        width: 88px; height: 22px;
        border-width: 1px + 1px * pulse;
        border-color: root.status-color;
        border-radius: 2px;
        background: root.status-color.with-alpha(0.22);
        drop-shadow-color: root.status-color;
        drop-shadow-blur: 4px + 4px * pulse;
        drop-shadow-offset-x: 0;
        drop-shadow-offset-y: 0;

        Text {
            width: 100%; height: 100%;
            text: root.status-label;
            font-family: Theme.font-mono;
            font-size: Theme.font-sm;
            font-weight: 700;
            color: root.status-color.brighter(0.8);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
