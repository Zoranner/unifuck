import { ScrollView } from "std-widgets.slint";
import { Theme } from "styles/theme.slint";
import { HeaderBar } from "layouts/header-bar.slint";
import { ActionBar } from "layouts/action-bar.slint";
import { WarningBanner } from "layouts/warning-banner.slint";
import { GroupRow } from "components/group-row.slint";
import { RGBSplitText } from "effects/rgb-split-text.slint";
import { NeonButton } from "effects/neon-button.slint";
import { Scanlines } from "effects/scanlines.slint";
import { Noise } from "effects/noise.slint";
import { HUDCorners } from "effects/hud-corners.slint";

export struct RowData {
    version: string, path: string, status: string, status-color: color,
    selected: bool, disabled: bool, is-group-header: bool,
}

export component AppWindow inherits Window {
    title: "unifuck";
    icon: @image-url("assets/app-icon.png");
    no-frame: true;
    min-width: 440px; min-height: 320px;
    max-width: 440px; max-height: 320px;
    preferred-width: 440px; preferred-height: 320px;
    background: Theme.purple-bg-0;

    in-out property <bool> show-result-dialog: false;
    in-out property <string> result-text: "";
    in property <int> success-code: 0;
    in property <int> operation-type: 0;   // 0=patch, 1=unpatch
    in-out property <string> status-text: "READY";
    in-out property <bool> working: false;
    in-out property <bool> done: false;
    in-out property <[RowData]> installs;
    in property <int> version-count: 0;
    in property <bool> is-unpatch: false;
    in property <bool> has-selection: false;
    in property <string> app-version;
    property <int> glitch-frame: 0;
    property <bool> glitch-on: Math.mod(glitch-frame, 17) == 0 || Math.mod(glitch-frame, 29) == 0;

    // Dialog button text rotation
    property <[string]> ok-button-texts: [
        "HAIL HYDRA",
        "FOR THE EMPEROR",
        "THE DIE IS CAST",
        "MISSION ACCOMPLISHED",
        "CHAOS REIGNS",
        "BOW BEFORE US",
        "WE ARE LEGION",
    ];
    property <[string]> fail-button-texts: [
        "DAMN IT",
        "F**K OFF",
        "BURN IN HELL",
        "F**K",
        "PIECE OF SH*T",
        "EAT SH*T",
        "GO DIE",
    ];

    callback activate();
    callback toggle-select(int);
    callback add_hub_folder();
    callback poll();
    callback dismiss_result();
    callback minimize_window();
    callback close_window();
    callback drag_start();
    callback drag_move();

    Timer { interval: 150ms; running: root.working; triggered => { root.poll(); } }
    Timer {
        interval: 110ms;
        running: true;
        triggered => {
            root.glitch-frame = Math.mod(root.glitch-frame + 1, 180);
        }
    }

    VerticalLayout {
        spacing: 0;
        HeaderBar {
            version: root.app-version;
            close-disabled: root.working;
            minimize => { root.minimize_window(); }
            close => { root.close_window(); }
            drag-start => { root.drag_start(); }
            drag-move => { root.drag_move(); }
        }

        WarningBanner { }

        if root.version-count == 0 : Rectangle {
            vertical-stretch: 1;
            background: transparent;
            VerticalLayout {
                padding-left: Theme.space-xl; padding-right: Theme.space-xl;
                padding-top: 40px; padding-bottom: 40px;
                spacing: Theme.space-md;
                alignment: center;
                Text {
                    text: "[ NO HUBS FOUND ]";
                    font-family: Theme.font-mono;
                    font-size: Theme.font-md; font-weight: 700;
                    color: Theme.magenta-50;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Register, Program Files, or add custom Hub folder.";
                    font-family: Theme.font-mono;
                    font-size: Theme.font-xs; color: Theme.text-faint;
                    horizontal-alignment: center;
                }
            }
        }
        if root.version-count > 0 : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                for item[i] in root.installs : GroupRow {
                    selected: item.selected; version: item.version;
                    path: item.path; status-label: item.status;
                    status-color: item.status-color; working: root.working;
                    disabled: item.disabled; is-group-header: item.is-group-header;
                    toggled => { root.toggle-select(i); }
                }
            }
        }

        WarningBanner { }

        ActionBar {
            vertical-stretch: 0;
            working: root.working;
            is-unpatch: root.is-unpatch;
            has-selection: root.has-selection;
            activate => { root.activate(); }
            add_hub_folder => { root.add_hub_folder(); }
        }
    }

    // === 赛博朋克背景层 (最底层装饰, 不阻挡交互) ===

    // 扫描线 (多条水平亮带, 缓慢从上往下扫, ~10s 周期)
    Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        background: transparent;
        Rectangle {
            x: 0;
            y: Math.mod(root.glitch-frame, 91) * 4px - 60px;
            width: 100%;
            height: 40px;
            background: @linear-gradient(180deg, #00ffff00 0%, #00ffff22 40%, #00ffff33 70%, #00ffff00 100%);
            opacity: 0.1;
        }
        Rectangle {
            x: 0;
            y: Math.mod(root.glitch-frame + 45, 91) * 4px - 60px;
            width: 100%;
            height: 24px;
            background: @linear-gradient(180deg, #ff2e9a00 0%, #ff2e9a22 50%, #ff2e9a00 100%);
            opacity: 0.08;
        }
        Rectangle {
            x: 0;
            y: Math.mod(root.glitch-frame * 2 + 30, 120) * 3px - 40px;
            width: 100%;
            height: 14px;
            background: @linear-gradient(180deg, #00ffff00 0%, #00ffff22 50%, #00ffff00 100%);
            opacity: 0.06;
        }
    }

    // 数据噪点 (小矩形在伪随机位置闪烁, opacity 0.03)
    Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        background: transparent;
        for noise[i] in 18 : Rectangle {
            x: Math.mod(i * 37 + root.glitch-frame * (7 + Math.mod(i, 5)), 400) * 1px;
            y: Math.mod(i * 53 + root.glitch-frame * (3 + Math.mod(i, 4)), 290) * 1px;
            width: 2px + Math.mod(i, 3) * 1px;
            height: 1px + Math.mod(i + 1, 3) * 1px;
            background: Math.mod(i, 3) == 0 ? #ff2e9a : #00ffff;
            opacity: Math.mod(root.glitch-frame + i * 7, 11) < 4 ? 0.03 : 0.0;
        }
    }

    // 背景扫描线 (装饰层, 不参与交互)
    Rectangle {
        x: 0;
        y: 54px + Math.mod(root.glitch-frame * 3, 180) * 1px;
        width: 100%;
        height: 1px;
        background: Theme.cyan-50;
        opacity: 0.10;
    }
    Rectangle {
        x: 0;
        y: 96px + Math.mod(root.glitch-frame * 5, 120) * 1px;
        width: 100%;
        height: 1px;
        background: Theme.magenta-50;
        opacity: root.glitch-on ? 0.22 : 0.07;
    }
    Rectangle {
        x: 0;
        y: 150px + Math.mod(root.glitch-frame * 2, 90) * 1px;
        width: 100%;
        height: 1px;
        background: #ffd400;
        opacity: root.glitch-on ? 0.16 : 0.04;
    }

    // 外层 1px 霓虹边 (置顶, 不阻挡事件)
    Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        background: transparent;
        border-width: 1px;
        border-color: Theme.magenta-50;
        opacity: 0.6;
    }
    Rectangle {
        x: Math.mod(root.glitch-frame * 23, 360) * 1px;
        y: 0;
        width: root.glitch-on ? 64px : 28px;
        height: 1px;
        background: root.glitch-on ? #ffd400 : Theme.cyan-50;
        opacity: root.glitch-on ? 0.9 : 0.4;
    }
    Rectangle {
        x: parent.width - 1px;
        y: Math.mod(root.glitch-frame * 11, 260) * 1px;
        width: 1px;
        height: root.glitch-on ? 54px : 20px;
        background: Theme.cyan-50;
        opacity: root.glitch-on ? 0.8 : 0.35;
    }

    // === 结果 Dialog: 成功=青描边, 失败=品红描边 ===
    if root.show-result-dialog : dlg := Rectangle {
        x: 0; y: 30px; width: 100%; height: parent.height - 30px;
        background: Theme.dialog-backdrop;

        property <color> accent-color: root.success-code == 1 ? Theme.cyan-50 : Theme.magenta-50;
        property <color> accent-glow: root.success-code == 1 ? Theme.cyan-glow : Theme.magenta-glow;
        property <color> accent-bright: root.success-code == 1 ? Theme.cyan-bright : Theme.magenta-bright;
        property <color> secondary-color: root.success-code == 1 ? Theme.magenta-50 : Theme.cyan-50;
        property <bool> dlg-glitch: Math.mod(root.glitch-frame, 13) == 0 || Math.mod(root.glitch-frame, 23) == 0;

        // 外发光层
        Rectangle {
            width: 360px; height: 160px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: transparent;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: dlg.accent-color;
            drop-shadow-color: dlg.accent-glow;
            drop-shadow-blur: 20px;
            drop-shadow-offset-x: 0;
            drop-shadow-offset-y: 0;
        }
        Rectangle {
            width: dlg.dlg-glitch ? 160px : 72px;
            height: 2px;
            x: (parent.width - 360px) / 2 + 20px + Math.mod(root.glitch-frame * 19, 160) * 1px;
            y: (parent.height - 160px) / 2 - 2px;
            background: dlg.dlg-glitch ? #ffd400 : dlg.secondary-color;
            opacity: dlg.dlg-glitch ? 0.95 : 0.35;
        }

        Rectangle {
            width: 360px; height: 160px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-md;
            background: Theme.purple-bg-1;
            border-width: 1px;
            border-color: dlg.accent-color;

            // 扫描线效果
            Scanlines {
                accent: dlg.accent-color;
                count: 3;
            }

            // 角落装饰 (HUD 风格 L 形标记)
            HUDCorners {
                accent: dlg.accent-color;
                arm-length: 12px;
                arm-width: 2px;
                corner-opacity: 0.8;
            }

            // 内层次色描边
            Rectangle {
                x: 3px; y: 3px;
                width: parent.width - 6px;
                height: parent.height - 6px;
                background: transparent;
                border-radius: 2px;
                border-width: 1px;
                border-color: dlg.secondary-color;
                opacity: 0.6;
            }

            // 噪点效果
            Noise {
                accent: dlg.accent-color;
                count: 5;
                active: root.glitch-on;
                glitch-frame: root.glitch-frame;
            }

            VerticalLayout {
                padding-left: Theme.space-2xl; padding-right: Theme.space-2xl;
                padding-top: Theme.space-xl; padding-bottom: Theme.space-xl;
                spacing: Theme.space-sm;

                // 标题
                HorizontalLayout {
                    height: 24px;
                    Text {
                        text: root.success-code == 1
                            ? (root.operation-type == 1 ? "✅ UN-PATCH COMPLETE" : "✅ PATCH COMPLETE")
                            : (root.operation-type == 1 ? "❌ UN-PATCH FAILED" : "❌ PATCH FAILED");
                        font-family: Theme.font-mono;
                        font-size: Theme.font-md;
                        font-weight: 700;
                        letter-spacing: 1px;
                        color: dlg.accent-bright;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: root.result-text;
                    font-family: Theme.font-mono;
                    font-size: Theme.font-xs;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }

                // 关闭按钮 (NeonButton: 霓虹发光 + glitch + 粒子 + 波纹)
                NeonButton {
                    horizontal-stretch: 1;
                    height: Theme.control-height;
                    text: root.success-code == 1
                        ? root.ok-button-texts[Math.mod(root.glitch-frame / 20, root.ok-button-texts.length)]
                        : root.fail-button-texts[Math.mod(root.glitch-frame / 20, root.fail-button-texts.length)];
                    accent: dlg.accent-color;
                    accent-secondary: dlg.secondary-color;
                    accent-glow: dlg.accent-glow;
                    glitch-frame: root.glitch-frame;
                    glitch-active: dlg.dlg-glitch;
                    clicked => { root.dismiss_result(); }
                }
            }

            // RGB 分离层 (标题): 绝对定位, z-order 高于 VerticalLayout
            RGBSplitText {
                x: Theme.space-2xl;
                y: Theme.space-xl;
                width: 280px;
                height: 24px;
                text: root.success-code == 1
                    ? (root.operation-type == 1 ? "✅ UN-PATCH COMPLETE" : "✅ PATCH COMPLETE")
                    : (root.operation-type == 1 ? "❌ UN-PATCH FAILED" : "❌ PATCH FAILED");
                font-family: Theme.font-mono;
                font-size: Theme.font-md;
                font-weight: 700;
                letter-spacing: 1px;
                text-color: transparent;
                offset: 1px;
                active: dlg.dlg-glitch;
                vertical-alignment: 1;
            }
        }
    }
}
