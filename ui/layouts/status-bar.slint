import { Theme } from "../styles/theme.slint";

// 顶栏: 全区拖动 TouchArea + 标题 + 右侧最小化/关闭 + 底部发光线
export component HeaderBar inherits Rectangle {
    callback minimize;
    callback close;
    callback drag-start;
    callback drag-move;

    in property <string> version;

    min-height: 30px;
    max-height: 30px;
    vertical-stretch: 0;
    background: Theme.cyan-50;

    // 拖动 TouchArea (排除右侧 72px 按钮区, 显式 30px 高度)
    drag-area := TouchArea {
        x: 0; y: 0;
        width: parent.width - 72px;
        height: 30px;
        mouse-cursor: move;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.drag-start();
            }
        }
        moved => {
            root.drag-move();
        }
    }

    // 标题
    HorizontalLayout {
        x: Theme.space-md; y: 0;
        height: 100%;
        spacing: Theme.space-sm;
        alignment: start;
        Image {
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            source: @image-url("../assets/app-icon.png");
        }
        Text {
            text: "UNIFUCK";
            font-family: Theme.font-mono;
            font-size: Theme.font-md;
            font-weight: 700;
            letter-spacing: 1px;
            color: Theme.magenta-50;
            vertical-alignment: center;
        }
        Text {
            text: "v" + root.version;
            font-family: Theme.font-mono;
            font-size: Theme.font-xs;
            font-weight: 600;
            letter-spacing: 0.5px;
            color: Theme.purple-bg-3;
            vertical-alignment: center;
        }
    }

    // 最小化按钮
    Rectangle {
        x: parent.width - 72px; y: 0;
        width: 36px; height: 100%;
        background: min-area.has-hover ? Theme.cyan-bright : transparent;
        min-area := TouchArea {
            clicked => { root.minimize(); }
        }
        Text {
            width: 100%; height: 100%;
            text: "−";
            font-family: Theme.font-mono;
            font-size: 16px;
            font-weight: 700;
            color: Theme.purple-bg-0;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // 关闭按钮
    Rectangle {
        x: parent.width - 36px; y: 0;
        width: 36px; height: 100%;
        background: close-area.has-hover ? Theme.magenta-50 : transparent;
        close-area := TouchArea {
            clicked => { root.close(); }
        }
        Text {
            width: 100%; height: 100%;
            text: "×";
            font-family: Theme.font-mono;
            font-size: 18px;
            font-weight: 700;
            color: close-area.has-hover ? Theme.text-bright : Theme.purple-bg-0;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // 底边发光线 (品红) - 置顶, 不被按钮 hover bg 遮挡
    Rectangle {
        x: 0; y: parent.height - 1px;
        width: 100%; height: 1px;
        background: Theme.magenta-50;
        opacity: 0.7;
        drop-shadow-color: Theme.magenta-glow;
        drop-shadow-blur: 6px;
        drop-shadow-offset-x: 0;
        drop-shadow-offset-y: 0;
    }
}
