import { Theme } from "../styles/theme.slint";

// 顶栏: 全区拖动 TouchArea + 标题 + 右侧最小化/关闭 + 底部发光线
export component HeaderBar inherits Rectangle {
    callback minimize;
    callback close;
    callback drag-start;
    callback drag-move;

    in property <string> version;
    property <int> glitch-frame: 0;
    property <bool> glitch-on: Math.mod(glitch-frame, 12) == 0 || Math.mod(glitch-frame, 19) == 0;
    property <length> glitch-shift: glitch-on ? 2px : 0px;

    min-height: 30px;
    max-height: 30px;
    vertical-stretch: 0;
    background: Theme.purple-bg-0;

    Timer {
        interval: 95ms;
        running: true;
        triggered => {
            root.glitch-frame = Math.mod(root.glitch-frame + 1, 120);
        }
    }

    // 拖动 TouchArea (排除右侧 72px 按钮区, 显式 30px 高度)
    drag-area := TouchArea {
        x: 0; y: 0;
        width: parent.width - 72px;
        height: 30px;
        mouse-cursor: move;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.drag-start();
            }
        }
        moved => {
            root.drag-move();
        }
    }

    Text {
        x: Theme.space-md + 28px - root.glitch-shift;
        y: 7px;
        text: "UNIFUCK";
        font-family: Theme.font-mono;
        font-size: Theme.font-md;
        font-weight: 700;
        letter-spacing: 1px;
        color: Theme.cyan-50;
        opacity: root.glitch-on ? 0.55 : 0;
    }

    Text {
        x: Theme.space-md + 28px + root.glitch-shift;
        y: 7px;
        text: "UNIFUCK";
        font-family: Theme.font-mono;
        font-size: Theme.font-md;
        font-weight: 700;
        letter-spacing: 1px;
        color: Theme.magenta-50;
        opacity: root.glitch-on ? 0.45 : 0;
    }

    // 标题
    HorizontalLayout {
        x: Theme.space-md; y: 0;
        height: 100%;
        spacing: Theme.space-sm;
        alignment: start;
        Image {
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            source: @image-url("../assets/app-icon.png");
        }
        Text {
            text: "UNIFUCK";
            font-family: Theme.font-mono;
            font-size: Theme.font-md;
            font-weight: 700;
            letter-spacing: 1px;
            color: #ffd400;
            vertical-alignment: center;
        }
        Text {
            text: "v" + root.version;
            font-family: Theme.font-mono;
            font-size: Theme.font-xs;
            font-weight: 600;
            letter-spacing: 0.5px;
            color: Theme.cyan-bright;
            vertical-alignment: center;
        }
    }

    // 最小化按钮
    Rectangle {
        x: parent.width - 72px; y: 0;
        width: 36px; height: 100%;
        background: min-area.has-hover ? Theme.cyan-glow-soft : transparent;
        min-area := TouchArea {
            clicked => { root.minimize(); }
        }
        Text {
            width: 100%; height: 100%;
            text: "−";
            font-family: Theme.font-mono;
            font-size: 16px;
            font-weight: 700;
            color: min-area.has-hover ? Theme.cyan-bright : Theme.text-bright;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // 关闭按钮
    Rectangle {
        x: parent.width - 36px; y: 0;
        width: 36px; height: 100%;
        background: close-area.has-hover ? Theme.magenta-50 : transparent;
        close-area := TouchArea {
            clicked => { root.close(); }
        }
        Text {
            width: 100%; height: 100%;
            text: "×";
            font-family: Theme.font-mono;
            font-size: 18px;
            font-weight: 700;
            color: close-area.has-hover ? Theme.text-bright : Theme.magenta-bright;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // 底边发光线 (青色) - 置顶, 不被按钮 hover bg 遮挡
    Rectangle {
        x: 0; y: parent.height - 1px;
        width: 100%; height: 1px;
        background: Theme.cyan-50;
        opacity: 0.7;
        drop-shadow-color: Theme.cyan-glow;
        drop-shadow-blur: 6px;
        drop-shadow-offset-x: 0;
        drop-shadow-offset-y: 0;
    }

    Rectangle {
        x: Math.mod(root.glitch-frame * 17, 360) * 1px;
        y: parent.height - 2px;
        width: root.glitch-on ? 58px : 22px;
        height: 1px;
        background: root.glitch-on ? Theme.magenta-50 : #ffd400;
        opacity: root.glitch-on ? 0.9 : 0.35;
    }
}
