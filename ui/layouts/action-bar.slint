import { Theme } from "../styles/theme.slint";
import { NeonButton } from "../effects/neon-button.slint";

// 底栏: 居中霓虹发光按钮 + 间歇 glitch (RGB 分裂)
export component ActionBar inherits Rectangle {
    in property <bool> busy;
    in property <bool> is-unpatch;
    in property <bool> has-selection;
    callback activate();

    property <bool> disabled: busy || !has-selection;

    // === Glitch 状态 (参考 HeaderBar: 帧计数 + 双素数模判定, 伪随机间歇) ===
    // 100ms × 600 帧 = 60s 完整周期; mod 29 ≈ 2.9s, mod 41 ≈ 4.1s, 各持续 100ms
    property <int> glitch-frame: 0;
    property <bool> glitch-active: !root.disabled
        && (Math.mod(root.glitch-frame, 29) == 0 || Math.mod(root.glitch-frame, 41) == 0);

    min-height: 44px;
    max-height: 44px;
    vertical-stretch: 0;
    background: Theme.purple-bg-1;

    // 顶部发光分隔线 (品红)
    Rectangle {
        x: 0; y: 0;
        width: 100%; height: 1px;
        background: Theme.magenta-50;
        opacity: 0.6;
        drop-shadow-color: Theme.magenta-glow;
        drop-shadow-blur: 6px;
        drop-shadow-offset-x: 0;
        drop-shadow-offset-y: 0;
    }

    HorizontalLayout {
        width: 100%; height: 28px;
        y: (parent.height - self.height) / 2;
        padding-left: Theme.space-md; padding-right: Theme.space-md;
        spacing: Theme.space-md;
        alignment: center;

        Rectangle { horizontal-stretch: 1; }

        NeonButton {
            width: 150px;
            height: 28px;
            text: root.busy
                ? (root.is-unpatch ? "UN-PATCHING..." : "PATCHING...")
                : (root.is-unpatch ? "UN-PATCH" : "PATCH");
            disabled: root.disabled;
            glitch-frame: root.glitch-frame;
            glitch-active: root.glitch-active;
            clicked => { root.activate(); }
        }

        Rectangle { horizontal-stretch: 1; }
    }

    // Glitch 帧定时器 (100ms, 始终运行, 双素数模判定产生 2-4s 间歇脉冲)
    Timer {
        interval: 100ms;
        running: true;
        triggered => {
            root.glitch-frame = Math.mod(root.glitch-frame + 1, 600);
        }
    }
}
