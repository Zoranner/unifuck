import { Theme } from "../styles/theme.slint";

// 扫描线效果: 多条水平亮带在容器内自上而下循环移动
// 内部 Timer 驱动动画, clip 防止溢出
export component Scanlines inherits Rectangle {
    in property <color> accent: Theme.cyan-50;
    in property <int> count: 3;
    in property <float> speed: 1.0;

    width: 100%;
    height: 100%;
    background: transparent;
    clip: true;

    property <int> frame: 0;
    Timer {
        interval: 110ms;
        running: true;
        triggered => { frame = Math.mod(frame + 1, 10000); }
    }

    // 扫描线 1: 40px 高, 较慢
    if root.count >= 1 : Rectangle {
        x: 0;
        y: Math.mod(frame * root.speed, 91) * 4px - 60px;
        width: 100%;
        height: 40px;
        background: @linear-gradient(180deg, transparent 0%, root.accent.with-alpha(0.13) 40%, root.accent.with-alpha(0.20) 70%, transparent 100%);
        opacity: 0.1;
    }

    // 扫描线 2: 24px 高, 偏移起始位置
    if root.count >= 2 : Rectangle {
        x: 0;
        y: Math.mod(frame * root.speed + 45, 91) * 4px - 60px;
        width: 100%;
        height: 24px;
        background: @linear-gradient(180deg, transparent 0%, root.accent.with-alpha(0.13) 50%, transparent 100%);
        opacity: 0.08;
    }

    // 扫描线 3: 14px 高, 更快速率
    if root.count >= 3 : Rectangle {
        x: 0;
        y: Math.mod(frame * root.speed * 2 + 30, 120) * 3px - 40px;
        width: 100%;
        height: 14px;
        background: @linear-gradient(180deg, transparent 0%, root.accent.with-alpha(0.13) 50%, transparent 100%);
        opacity: 0.06;
    }
}
